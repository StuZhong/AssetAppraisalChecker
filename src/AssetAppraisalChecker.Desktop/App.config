<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 本地离线 AI 可选。填写已部署的冻结资产根目录；相对路径以 EXE 目录为准。
         留空时也可用进程环境变量 ASSETAPPRAISALCHECKER_MODEL_ROOT 提供路径。
         不下载模型；不配置时保留规则校检。修改配置后重启程序。 -->
    <add key="LocalModelRoot" value="" />
    <!-- 留空使用 EXE 目录内的 ortextensions.dll。 -->
    <add key="OrtExtensionsLibraryPath" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
