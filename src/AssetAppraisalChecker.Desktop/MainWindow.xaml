<Window x:Class="AssetAppraisalChecker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AssetAppraisalChecker - 资产评估报告校检工具"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#246B73" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D5960" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263238" />
            <Setter Property="BorderBrush" Value="#AAB4BA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="IssueRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="严重">
                    <Setter Property="Background" Value="#FFF1F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="一般">
                    <Setter Property="Background" Value="#FFF9E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="提醒">
                    <Setter Property="Background" Value="#EEF6FA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#214E55" Padding="22,15">
            <StackPanel>
                <TextBlock Text="AssetAppraisalChecker"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="资产评估报告校检工具 · 本地离线只读校检"
                           Margin="0,3,0,0"
                           Foreground="#DDEBED"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="18,14,18,0"
                Padding="14"
                Background="White"
                BorderBrush="#D8DEE2"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="文档 A：" />
                <Button x:Name="SelectDocumentAButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Content="选择文档 A"
                        Click="SelectDocumentAButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="OpenDocumentAButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="打开文档 A"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenDocumentACommand}" />

                <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentAFileName}"
                               FontWeight="SemiBold"
                               Foreground="#263238"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DocumentAPath}" />
                    <TextBlock Text="{Binding DocumentAPath}"
                               Margin="0,2,0,0"
                               Foreground="#65747C"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DocumentAPath}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,8,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="文档 B：" />
                <Button x:Name="SelectDocumentBButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,10,0"
                        Content="选择文档 B（可选）"
                        Click="SelectDocumentBButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="打开文档 B"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenDocumentBCommand}" />
                    <Button Content="清除文档 B"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ClearDocumentBButton_Click" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentBFileName}"
                               FontWeight="SemiBold"
                               Foreground="#263238"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DocumentBPath}" />
                    <TextBlock Text="{Binding DocumentBPath}"
                               Margin="0,2,0,0"
                               Foreground="#65747C"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DocumentBPath}" />
                </StackPanel>

                <Button x:Name="StartCheckButton"
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="10,12,0,0"
                        Content="开始校检"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartCheckCommand}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,12,10,0"
                           VerticalAlignment="Center"
                           Text="正确项目名称（可选）：" />
                <TextBox x:Name="ExpectedProjectNameTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="30"
                         Margin="0,12,0,0"
                         Padding="7,4"
                         VerticalContentAlignment="Center"
                         IsReadOnly="{Binding IsBusy}"
                         Text="{Binding ExpectedProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ProgressBar Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"
                             Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,12,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="严重问题" Foreground="#8B2D2D" />
                    <TextBlock Text="{Binding SeriousCount}" FontSize="24" FontWeight="SemiBold" Foreground="#8B2D2D" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="一般问题" Foreground="#7A5B16" />
                    <TextBlock Text="{Binding NormalCount}" FontSize="24" FontWeight="SemiBold" Foreground="#7A5B16" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="提醒" Foreground="#356477" />
                    <TextBlock Text="{Binding ReminderCount}" FontSize="24" FontWeight="SemiBold" Foreground="#356477" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="总问题数" Foreground="#37474F" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="SemiBold" Foreground="#37474F" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="3,6,0,0"
                       Text="{Binding DisplayModeDescription}" Foreground="#546E7A" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="3" Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE2" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="校检问题" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="视图：" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="IssueDisplayModeComboBox" Width="105" Margin="0,0,12,0"
                                      ItemsSource="{Binding DisplayModeOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Mode"
                                      SelectedValue="{Binding SelectedDisplayMode, Mode=TwoWay}" />
                            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="SeverityFilterComboBox"
                                      Width="100"
                                      ItemsSource="{Binding FilterOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Filter"
                                      SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="IssueDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Issues}"
                              SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowStyle="{StaticResource IssueRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="严重程度" Binding="{Binding SeverityDisplay}" Width="72" />
                            <DataGridTextColumn Header="问题类型" Binding="{Binding IssueTypeDisplay}" Width="110" />
                            <DataGridTextColumn Header="字段名称" Binding="{Binding FieldName}" Width="135" />
                            <DataGridTextColumn Header="问题摘要" Binding="{Binding Summary}" Width="*" />
                            <DataGridTextColumn Header="位置" Binding="{Binding PrimaryLocation}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE2" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="问题详情" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="请从左侧问题列表中选择一条记录查看证据。"
                                   Margin="0,8,0,0"
                                   Foreground="#65747C">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedIssue}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <WrapPanel Margin="0,10,0,8">
                            <Button Content="定位到原文" Command="{Binding NavigateToSourceCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="复制问题详情" Command="{Binding CopyIssueDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding HasSelectedIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="选择要定位的位置（按问题的文档来源）" Foreground="#65747C" />
                            <ComboBox ItemsSource="{Binding SelectedIssue.Occurrences}"
                                      SelectedItem="{Binding SelectedNavigationOccurrence}"
                                      DisplayMemberPath="NavigationDisplay" Margin="0,6,0,8" />
                            <TextBlock Text="{Binding NavigationMessage}" TextWrapping="Wrap" Foreground="#246B73" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="打开原文" Command="{Binding OpenSourceCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="复制原文片段" Command="{Binding CopySourceSnippetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <TextBlock Text="以下详情可选中文字并按 Ctrl+C 复制" Foreground="#65747C" Margin="0,0,0,6" />
                            <TextBox Text="{Binding SelectedIssueDetails, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                                     Background="#F8FAFB" Padding="10" VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#E6EBEE" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock x:Name="AiStatusTextBlock" Text="{Binding AiStatusMessage}"
                           Foreground="#37474F" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock x:Name="StatusTextBlock"
                           Text="{Binding StatusMessage}"
                           Foreground="#37474F"
                           TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="只读校检 · 不修改原报告 · 不上传文件"
                           Foreground="#65747C"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
