<Window x:Class="AssetAppraisalChecker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AssetAppraisalChecker - 资产评估报告校检工具"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#246B73" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D5960" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#263238" />
            <Setter Property="BorderBrush" Value="#AAB4BA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DEE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="IssueRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="严重">
                    <Setter Property="Background" Value="#FFF1F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="一般">
                    <Setter Property="Background" Value="#FFF9E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityDisplay}" Value="提醒">
                    <Setter Property="Background" Value="#EEF6FA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#214E55" Padding="22,15">
            <StackPanel>
                <TextBlock Text="AssetAppraisalChecker"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="资产评估报告校检工具 · 本地离线只读校检"
                           Margin="0,3,0,0"
                           Foreground="#DDEBED"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="18,14,18,0"
                Padding="14"
                Background="White"
                BorderBrush="#D8DEE2"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SelectReportButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Content="选择报告"
                        Click="SelectReportButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="StartCheckButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Content="开始校检"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartCheckCommand}" />
                <Button x:Name="OpenReportButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Content="打开原报告"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenReportCommand}" />

                <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedFileName}"
                               FontWeight="SemiBold"
                               Foreground="#263238"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedFilePath}" />
                    <TextBlock Text="{Binding SelectedFilePath, TargetNullValue=尚未选择报告}"
                               Margin="0,2,0,0"
                               Foreground="#65747C"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedFilePath}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,12,10,0"
                           VerticalAlignment="Center"
                           Text="正确项目名称：" />
                <TextBox x:Name="ExpectedProjectNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="30"
                         Margin="0,12,0,0"
                         Padding="7,4"
                         VerticalContentAlignment="Center"
                         IsReadOnly="{Binding IsBusy}"
                         Text="{Binding ExpectedProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ProgressBar Grid.Row="2"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"
                             Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,12,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="严重问题" Foreground="#8B2D2D" />
                    <TextBlock Text="{Binding SeriousCount}" FontSize="24" FontWeight="SemiBold" Foreground="#8B2D2D" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="一般问题" Foreground="#7A5B16" />
                    <TextBlock Text="{Binding NormalCount}" FontSize="24" FontWeight="SemiBold" Foreground="#7A5B16" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="提醒" Foreground="#356477" />
                    <TextBlock Text="{Binding ReminderCount}" FontSize="24" FontWeight="SemiBold" Foreground="#356477" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="总问题数" Foreground="#37474F" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="SemiBold" Foreground="#37474F" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE2" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="校检问题" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="SeverityFilterComboBox"
                                      Width="100"
                                      ItemsSource="{Binding FilterOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Filter"
                                      SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="IssueDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Issues}"
                              SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowStyle="{StaticResource IssueRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="严重程度" Binding="{Binding SeverityDisplay}" Width="72" />
                            <DataGridTextColumn Header="问题类型" Binding="{Binding IssueTypeDisplay}" Width="110" />
                            <DataGridTextColumn Header="字段名称" Binding="{Binding FieldName}" Width="135" />
                            <DataGridTextColumn Header="问题摘要" Binding="{Binding Summary}" Width="*" />
                            <DataGridTextColumn Header="位置" Binding="{Binding PrimaryLocation}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE2" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="问题详情" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="请从左侧问题列表中选择一条记录查看证据。"
                                   Margin="0,8,0,0"
                                   Foreground="#65747C">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedIssue}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasSelectedIssue, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedIssue.SeverityDisplay}" FontWeight="SemiBold" Foreground="#7B3333" />
                            <TextBlock Text="{Binding SelectedIssue.IssueTypeDisplay}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedIssue.FieldName}" Margin="0,4,0,10" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="问题说明" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedIssue.Reason}" Margin="0,4,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="建议操作" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedIssue.SuggestedAction}" Margin="0,4,0,12" TextWrapping="Wrap" />

                            <TextBlock Text="涉及位置与证据" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedIssue.Occurrences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="10"
                                                Background="#F8FAFB"
                                                BorderBrush="#D8DEE2"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayIndex, StringFormat=位置 {0}}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="疑似异常"
                                                               Foreground="#A14820"
                                                               FontWeight="SemiBold"
                                                               Visibility="{Binding IsSuspectedOutlier, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                                <TextBlock Text="{Binding LocationText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Area, StringFormat=所在区域：{0}}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Subject, StringFormat=主体：{0}}"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasSubject, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="原始值" Margin="0,8,0,0" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" />
                                                <TextBlock Text="标准化值" Margin="0,6,0,0" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding NormalizedValue}" TextWrapping="Wrap" />
                                                <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="分类证据" Margin="0,6,0,0" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="已有解析警告" Margin="0,6,0,0" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding WarningsText}" Foreground="#8A5C1F" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding HasNearbyContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="附近文本" Margin="0,6,0,0" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding NearbyContext}" Foreground="#55636A" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#E6EBEE" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           Text="{Binding StatusMessage}"
                           Foreground="#37474F"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="只读校检 · 不修改原报告 · 不上传文件"
                           Foreground="#65747C"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
