<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AssetAppraisalChecker.Application.Tests</AssemblyName>
    <RootNamespace>AssetAppraisalChecker.Application.Tests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.Application\AssetAppraisalChecker.Application.csproj" />
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.Core\AssetAppraisalChecker.Core.csproj" />
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.CrossDocument\AssetAppraisalChecker.CrossDocument.csproj" />
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.Document\AssetAppraisalChecker.Document.csproj" />
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.Facts.Extraction\AssetAppraisalChecker.Facts.Extraction.csproj" />
