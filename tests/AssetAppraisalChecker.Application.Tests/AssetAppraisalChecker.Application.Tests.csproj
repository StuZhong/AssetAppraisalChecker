    <Content Include="..\AssetAppraisalChecker.Tests\GoldenCases\V2\Manifest.json">
      <Link>GoldenCases\V2\Manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\AssetAppraisalChecker.Tests\GoldenCases\V2\Runner\**\*">
      <Link>GoldenCases\V2\Runner\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <ProjectReference Include="..\..\src\AssetAppraisalChecker.Semantic\AssetAppraisalChecker.Semantic.csproj" />
  </ItemGroup>

